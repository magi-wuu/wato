<?xml version="1.0"?>
<!-- Visualization model. Joint origins match robot_env.sdf; live TF supplies link poses. -->
<robot name="robot">
  <link name="robot/chassis">
    <visual>
      <geometry>
        <box size="2.0 1.0 0.5" />
      </geometry>
      <material name="chassis_blue">
        <color rgba="0 0 1 1" />
      </material>
    </visual>
  </link>
  <link name="robot/left_wheel">
    <visual name="visual">
      <geometry>
        <cylinder radius="0.4" length="0.2" />
      </geometry>
      <material name="left_red">
        <color rgba="1 0 0 1" />
      </material>
    </visual>
  </link>
  <link name="robot/right_wheel">
    <visual name="visual">
      <geometry>
        <cylinder radius="0.4" length="0.2" />
      </geometry>
      <material name="right_red">
        <color rgba="1 0 0 1" />
      </material>
    </visual>
  </link>
  <link name="robot/caster">
    <visual name="visual">
      <geometry>
        <sphere radius="0.2" />
      </geometry>
      <material name="caster_green">
        <color rgba="0 1 0 1" />
      </material>
    </visual>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="robot/chassis" />
    <child link="robot/left_wheel" />
    <origin xyz="-0.5 0.6 0" rpy="-1.5707 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="100" velocity="100" />
  </joint>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="robot/chassis" />
    <child link="robot/right_wheel" />
    <origin xyz="-0.5 -0.6 0" rpy="-1.5707 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="100" velocity="100" />
  </joint>
  <joint name="caster_joint" type="fixed">
    <parent link="robot/chassis" />
    <child link="robot/caster" />
    <origin xyz="0.8 0 -0.2" rpy="0 0 0" />
  </joint>
</robot>
